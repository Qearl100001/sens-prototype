      "sourceRefs": ["source-designer-list-filter-status-feedback", "source-sens-kit"]
    },
    {
      "id": "req-list-actions",
      "description": "列表支持查看、运行或暂停、编辑、复制和删除；运行中禁止编辑与删除，已暂停允许编辑与删除。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-list-action-overflow",
      "description": "表格操作列最多展示查看、运行或暂停和更多三个入口；编辑、复制和删除收进更多，删除不在操作列外部单独展示。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-layout-actions-feedback", "source-sens-kit"]
    },
    {
      "id": "req-list-tab-divider",
      "description": "列表页 Tab 下方的分割线贯穿整个标题区，并延伸到右侧 Schema 配置和创建任务按钮下方。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-layout-actions-feedback", "source-sens-kit"]
    },
    {
      "id": "req-list-tab-rhythm",
      "description": "列表页保持正式 Sens 标题栏；其下 Tab 使用 40px 高度档、14px 字号、22px 行高和垂直居中布局，不叠加额外顶部内边距。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-tab-rhythm-feedback", "source-sens-kit"]
    },
    {
      "id": "req-small-confirm-actions",
      "description": "size=small 的二次确认使用 Sens 小按钮；当前列表删除确认与表单放弃确认的操作按钮为 24px 高、12px 字号。",
      "basis": "confirmed",
      "sourceRefs": ["source-figma-small-confirm", "source-sens-kit"]
    },
    {
      "id": "req-delete-confirm-anchor",
      "description": "列表删除确认 Popover 的定位触发区域与更多按钮完全重合，浮层箭头指向更多按钮的视觉中心线。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-detail-popover-feedback", "source-figma-small-confirm", "source-sens-kit"]
    },
    {
      "id": "req-local-alignment",
      "description": "表格操作列的更多文字与箭头保持同一视觉中心线；Hash 字段标题、标签和添加链接保持同一中心线。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-layout-actions-feedback", "source-sens-kit"]
    },
    {
      "id": "req-desktop-min-width",
      "description": "浏览器窄于 1280px 时保留 1280px 桌面页面结构并由横向滚动承接，列表、创建和详情页左右留白保持 24px，不随视口压缩。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-layout-actions-feedback", "source-sens-kit"]
    },
    {
      "id": "req-create-layout",
      "description": "创建页采用单页纵向表单与右侧四项锚点导航，包含任务基础信息、数据来源和目标、任务执行规则、报警监控。",
      "basis": "confirmed",
      "sourceRefs": ["source-prd-v3", "source-figma-stream-task", "source-user-flow-evidence", "source-p1b-confirmation"]
    },
    {
      "id": "req-create-anchor-typography",
      "description": "创建页右侧锚点保持桌面右栏布局，文字消费 Sens 14px / 22px 正文规格；默认 regular，选中项使用强调字重与品牌色。",
      "basis": "confirmed",
      "sourceRefs": ["source-designer-layout-actions-feedback", "source-sens-kit"]
    },
    {
      "id": "req-basic-info",
      "description": "任务名称必填、最多 100 个字符且仅支持字母、数字、下划线和中文；描述最多 200 个字符。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-source-linkage",
      "description": "来源连接仅展示消息队列类型；选择正常连接后解禁并过滤来源数据，半结构化来源进一步显示并过滤 Schema。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-source-exception",
      "description": "异常来源连接显示错误反馈与查看详情入口，并保持来源数据禁用。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-target-mapping",
      "description": "目标类型默认实体，目标数据可选择用户表、事件表或明细表；非神策标准 JSON 来源需要配置字段映射。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-standard-json",
      "description": "神策标准 JSON 来源显示标识，并提示无需配置同步目标和字段映射。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-execution",
      "description": "任务长期有效、长期执行；首次消费起始支持最早、最新、时间戳和特定偏移量，读取逻辑固定为追加更新。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-write-partition",
      "description": "写入逻辑随目标表类型只读展示；分区规则支持按并行度绑定或按有序字段 hash。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-exception-advanced",
      "description": "用户可选择是否跳过异常数据；高级设置包含并行度、优化参数和允许在强校验下创建事件或属性。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
      "id": "req-alarm",
      "description": "报警默认开启；可分别配置重启次数和跳过异常数据次数两类条件，关闭时隐藏配置。",
      "basis": "confirmed",
      "sourceRefs": ["source-prd-v3", "source-figma-stream-task", "source-p1b-confirmation"]
    },
    {
      "id": "req-data-preview",
      "description": "选定来源数据和 Schema 后可打开数据预览抽屉，展示加载、无数据或模拟数据状态。",
      "basis": "confirmed",
      "sourceRefs": ["source-figma-stream-task", "source-user-flow-evidence", "source-p1b-confirmation"]
    },
    {
      "id": "req-submit-state",
      "description": "提交时选择不立即运行则进入等待运行；运行和暂停必须由用户明确操作，编辑保存后同样回到等待运行。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
    },
    {
