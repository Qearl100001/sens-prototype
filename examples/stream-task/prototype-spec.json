  "requirements": [
    {
      "id": "req-list-entry",
      "description": "数据同步页面提供流任务 Tab 和创建任务入口；无数据时展示可引导创建的空态。",
      "basis": "explicit",
      "sourceRefs": ["source-prd-v3"]
