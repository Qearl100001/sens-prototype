  "scope": {
    "change": [
      "新增流任务列表及配额、状态和任务操作的原型规格。",
      "新增创建同步任务的单页四区配置流程规格。",
      "新增任务详情、暂停后编辑和复制任务页面规格。",
      "定义等待运行、运行中、运行异常、已暂停的任务状态转换。",
      "定义成功、失败、配额耗尽和权限受限的可重复模拟场景。",
      "补充桌面最小宽度、页面留白、右侧锚点文字和表格操作收纳规则。",
      "补充表格更多箭头与 Hash 字段内容的中心线对齐规则。",
      "补充小型二次确认的小按钮规格、列表 Tab 通栏分割线及 40px Tab 垂直节奏。",
      "补充列表任务状态色、200px 搜索框和 14/22 选择器文字规格。",
      "补充删除确认浮层与实际触发按钮的锚定规则，以及详情页正文层级、只读输入、映射图标、右侧锚点和标题栏操作规则。",
      "恢复 SensD 侧边导航基础组件的二级分组展开/收起能力，保持当前四组默认展开。"
    ],
    "preserve": [
      "使用固定版本 @sens/prototype-kit，不引用相邻 sens-preview 源码。",
      "保持 Sens Product Shell 的顶导、侧导、标题栏和内容滚动结构。",
      "设计审核状态仅依据设计师明确决定更新，不以 Agent 自查替代签字。"
    ],
    "excluded": [
      "真实 Kafka、Schema、任务调度、权限、Licence 和操作日志服务。",
      "运行记录页面的完整内容与运行日志详情。",
      "真实数据预览服务、P5 快捷筛选和列目设置。",
      "上游 sens-preview 组件或规则修改。",
      "国际化文案实现、真实文件下载和真实外部数据连接详情页。"
    ]
  },
