  "requirements": [
    { "id": "TC-R01", "description": "页面使用平台管理 Product Shell，侧导航选中项目管理→基本设置，交易日历不作为侧导航项。", "basis": "confirmed", "sourceRefs": ["SRC-SENS", "SRC-STRUCTURE"] },
    { "id": "TC-R02", "description": "默认展示当前月份的七列月历，可切换上一月、下一月和回到今天。", "basis": "explicit", "sourceRefs": ["SRC-PRD", "SRC-REF"] },
    { "id": "TC-R03", "description": "支持月视图与年视图切换；年视图展示十二个月并可进入对应月。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R04", "description": "日期单元格展示日期、交易日状态和可选备注，并区分今天与非本月日期。", "basis": "explicit", "sourceRefs": ["SRC-PRD", "SRC-REF"] },
    { "id": "TC-R05", "description": "交易日、非交易日、今天、辅助和禁用状态全部使用 SensD 语义 Token。", "basis": "confirmed", "sourceRefs": ["SRC-SENS", "SRC-DECISION"] },
    { "id": "TC-R06", "description": "首次未初始化时自动打开通知配置；暂不配置后保留警告并禁用编辑和上传。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R07", "description": "通知配置至少完成一种上传提醒渠道，保存后解锁编辑和上传。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R08", "description": "点击单个日期打开编辑抽屉，日期只读，状态可切换，备注最多 200 字。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R09", "description": "修改历史日期状态时进行二次确认，保存后刷新日历并反馈成功。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R10", "description": "批量编辑支持添加、删除日期范围并统一设置状态和备注。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R11", "description": "批量上传覆盖模板下载、文件格式错误、内容错误、校验通过和导入成功状态。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R12", "description": "没有管理权限时隐藏管理操作，但仍允许查看日历。", "basis": "explicit", "sourceRefs": ["SRC-PRD"] },
    { "id": "TC-R13", "description": "在小于 1280px 的桌面窗口中保留 24px 页面留白，不压缩为更小值。", "basis": "confirmed", "sourceRefs": ["SRC-SENS", "SRC-DECISION"] },
    { "id": "TC-R14", "description": "业务层不直接导入 antd，不复制 SensD 组件，不使用 hex、rgba、.ant-* 覆盖或 !important。", "basis": "confirmed", "sourceRefs": ["SRC-SENS", "SRC-DECISION"] },
    { "id": "TC-R15", "description": "基本设置落地页使用 SensD 设计系统的「入口类卡片」模式，点击交易日历卡片进入下钻页，下钻页可返回基本设置并支持浏览器前进后退。", "basis": "confirmed", "sourceRefs": ["SRC-STRUCTURE", "SRC-FIGMA-CARD", "SRC-SENS"] },
    { "id": "TC-R16", "description": "产品壳严格区分落地页与下钻页：落地页保留侧导航且白色标题栏与内容间距为 0；下钻页隐藏侧导航并使用浅绿色带返回标题栏，白色内容区顶部间距为 16px；壳体顶角为 10px，内容背景铺满页面。", "basis": "confirmed", "sourceRefs": ["SRC-SHELL-LAYOUT", "SRC-SENS"] },
    { "id": "TC-R17", "description": "交易日历核心区域参考飞书月历的信息层级，并按 SensD 规则实现：工具栏、图例与月份统计、星期栏、按月份实际占用的五或六周网格、今天、跨月日期及交易状态均使用既有 Design Token。", "basis": "confirmed", "sourceRefs": ["SRC-REF", "SRC-SENS", "SRC-DECISION"] },
    { "id": "TC-R18", "description": "单日编辑、批量编辑、批量上传和通知配置统一使用正式 SensDrawer 与标题栏：小/中抽屉遵守响应式宽度，内容区上 16px、左右及下 24px；上传区标题为 14/22、辅助文案为 12/18，顶部使用 SensAlert 的提醒类型；通知抽屉的标题、标签、值和 Alert 正文统一为 14/22；二级信息组间距为 40px；状态反馈使用语义图标与 Token，轻量二次确认锚定触发按钮并使用小按钮。", "basis": "confirmed", "sourceRefs": ["SRC-SENS", "SRC-FIGMA-ALERT", "SRC-FIGMA-UPLOAD-ALERT", "SRC-DECISION"] }
  ],
