        "r2"
      ]
    },
    {
      "id": "cancel",
      "pageId": "template",
      "fromState": "confirm-single",
      "trigger": "取消切换",
      "toState": "editing-multiple",
      "effect": "保持多选模式，按钮文案使用 PRD 正文的“暂不切换”。",
      "requirementRefs": [
        "r2"
      ]
    },
    {
      "id": "confirm",
      "pageId": "template",
      "fromState": "confirm-single",
      "trigger": "确认切换",
      "toState": "editing-single",
      "effect": "应用选择方式变为单选；其他值展示关闭并禁用。",
      "requirementRefs": [
        "r2",
        "r3"
      ]
    },
    {
      "id": "save",
      "pageId": "template",
      "fromState": "editing-single",
      "trigger": "保存抽屉",
      "toState": "saved-preview",
      "effect": "关闭抽屉并按 Radio 形态展示模板应用效果。",
      "requirementRefs": [
        "r1",
        "r4"
      ]
    },
    {
      "id": "select-no",
      "pageId": "template",
      "fromState": "saved-preview",
      "trigger": "应用态选择 No",
      "toState": "application-single",
      "effect": "No 选中，Yes 自动取消选中。",
      "requirementRefs": [
        "r4"
      ]
    },
    {
      "id": "submit-success",
      "pageId": "template",
      "fromState": "saved-preview",
      "trigger": "点击提交",
      "toState": "submit-success",
      "effect": "按钮进入加载态，结束后显示“创建成功”轻提示。",
      "requirementRefs": ["r8"]
    },
    {
      "id": "submit-failure",
      "pageId": "template",
      "fromState": "saved-preview",
      "trigger": "在 submitResult=failure 场景点击提交",
      "toState": "submit-failure",
      "effect": "按钮进入加载态，结束后显示“创建失败，请稍后重试”，并保留当前内容。",
      "requirementRefs": ["r8"]
    },
    {
      "id": "abandon-template",
      "pageId": "template",
      "fromState": "saved-preview",
      "trigger": "点击返回或放弃并确认",
      "toState": "abandoned",
      "effect": "重置表单和已选特征，显示“已放弃本次创建”轻提示。",
      "requirementRefs": ["r9"]
    }
  ],
