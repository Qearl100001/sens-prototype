  "requirements": [
    {
      "id": "r1",
      "description": "应用选择方式默认多选；单选应用态最多选择一个候选值。",
      "basis": "explicit",
      "sourceRefs": [
        "prd-1"
      ]
    },
    {
      "id": "r2",
      "description": "多选切换为单选时显示切换确认。",
      "basis": "explicit",
      "sourceRefs": [
        "prd-1"
      ]
    },
    {
      "id": "r3",
      "description": "单选与其他互斥；切换为单选时关闭其他值展示并将其禁用，提示仅多选支持。",
      "basis": "explicit",
      "sourceRefs": [
        "prd-1"
      ]
    },
    {
      "id": "r4",
      "description": "保存为单选后，应用态使用 Radio；选择 No 自动取消 Yes，不允许同时保存两个值。",
      "basis": "explicit",
      "sourceRefs": [
        "prd-1"
      ]
    },
    {
      "id": "r5",
      "description": "已选特征按字段配置状态展示未配置提示、运算符与特征值、区间平铺、选择方式四种形态；字段名和配置内容使用 14px/22px/regular 正文排版，不使用标题字重。",
      "basis": "explicit",
      "sourceRefs": [
        "screenshots-2",
        "sens-1"
      ]
    },
    {
      "id": "r6",
      "description": "添加特征与添加特征值均支持双栏选择、放弃确认和保存回填；添加特征保存时展示加载状态。",
      "basis": "explicit",
      "sourceRefs": ["recording-1", "sens-1"]
    },
    {
      "id": "r7",
      "description": "数值型特征支持使用区间或离散数字设置，并把保存结果展示为行内复选项。",
      "basis": "explicit",
      "sourceRefs": ["recording-1", "sens-1"]
    },
    {
      "id": "r8",
      "description": "页面提交必须展示加载过程和明确结果；默认模拟创建成功，使用 submitResult=failure 查询参数可重复验证创建失败。",
      "basis": "confirmed",
      "category": "flow",
      "readinessImpact": "blocking",
      "questionRefs": [],
      "sourceRefs": ["sens-1", "decision-p0-6-scope"]
    },
    {
      "id": "r9",
      "description": "页面返回或放弃必须二次确认；确认后重置当前创建内容并反馈结果。当前试点不支持的新增特征组和黑名单操作必须禁用，不得保留静默按钮。",
      "basis": "confirmed",
      "category": "flow",
      "readinessImpact": "blocking",
      "questionRefs": [],
      "sourceRefs": ["sens-1", "decision-p0-6-scope"]
    }
  ],
