{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sens Prototype Spec",
  "description": "原型工作流结构契约；业务正确性、引用完整性和实际证据须另行检查。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "intake",
        "ready",
        "generated",
        "checked"
      ]
    },
    "mode": {
      "enum": [
        "incremental",
        "feature",
        "module"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "change",
        "preserve",
        "excluded"
      ]
    },
    "actors": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor" }
    },
    "coreTasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/coreTask" }
    },
    "informationArchitecture": {
      "$ref": "#/$defs/informationArchitecture"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "flows": {
      "type": "array",
      "items": { "$ref": "#/$defs/flow" }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "Sens"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "unavailable",
            "pending_verification",
            "available"
          ]
        },
        "assetLocation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "templateRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetUsage" }
        },
        "compositeRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/assetUsage" }
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "assetLocation",
        "mappings",
        "gaps"
      ]
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataSource": {
          "const": "mock"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "reset": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "trigger",
              "reset"
            ]
          }
        },
        "persistence": {
          "enum": [
            "memory",
            "local_storage",
            "none",
            "undecided"
          ]
        }
      },
      "required": [
        "dataSource",
        "scenarios",
        "persistence"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "question",
          "blocking",
          "status",
          "resolution",
          "sourceRefs"
        ]
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirementRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "requirementRefs",
          "description"
        ]
      }
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "$ref": "#/$defs/check"
        },
        "sens": {
          "$ref": "#/$defs/check"
        },
        "interaction": {
          "$ref": "#/$defs/check"
        },
        "delivery": {
          "$ref": "#/$defs/check"
        },
        "reviewerMode": {
          "enum": [
            "not_started",
            "self_review",
            "independent_review"
          ]
        },
        "designStatus": {
          "enum": [
            "awaiting_designer",
            "changes_requested",
            "approved_with_followups",
            "approved"
          ]
        },
        "designerDecision": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifactRevision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requirement",
        "sens",
        "interaction",
        "delivery",
        "reviewerMode",
        "designStatus",
        "designerDecision",
        "artifactRevision"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "staticBundlePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "previewUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "publication": {
          "enum": [
            "not_published",
            "published"
          ]
        }
      },
      "required": [
        "projectPath",
        "staticBundlePath",
        "previewUrl",
        "publication"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "stage",
    "mode",
    "objective",
    "sources",
    "scope",
    "actors",
    "coreTasks",
    "informationArchitecture",
    "requirements",
    "pages",
    "interactions",
    "flows",
    "validations",
    "designSystem",
    "simulation",
    "questions",
    "acceptanceCriteria",
    "readiness",
    "review",
    "delivery"
  ],
  "$defs": {
    "informationArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "description": "PM 确认的产品层级与逐页入口、返回和深链关系。",
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "sideNavigationPath": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/informationArchitectureNode" }
        }
      },
      "required": ["product", "sideNavigationPath", "nodes"]
    },
    "informationArchitectureNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "pageLevel": { "enum": ["landing", "drilldown"] },
        "entryPoint": { "enum": ["side_navigation", "card", "table", "action", "direct_link", "other"] },
        "parentPageId": { "type": ["string", "null"] },
        "entryLabel": { "type": "string", "minLength": 1 },
        "returnTargetPageId": { "type": ["string", "null"] },
        "deepLinkPolicy": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["pageId", "pageLevel", "entryPoint", "parentPageId", "entryLabel", "returnTargetPageId", "deepLinkPolicy", "sourceRefs"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["id", "name", "goal", "sourceRefs"]
    },
    "coreTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "actorRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pageRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["id", "description", "actorRefs", "pageRefs", "requirementRefs", "sourceRefs"]
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["main", "exception"] },
        "actorRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "entryPageId": { "type": "string", "minLength": 1 },
        "interactionRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outcome": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["id", "name", "kind", "actorRefs", "entryPageId", "interactionRefs", "outcome", "sourceRefs"]
    },
    "readinessCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "confirmed", "not_applicable"] },
        "notes": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["status", "notes", "sourceRefs"]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["pending", "confirmed"] },
        "confirmedBy": { "type": ["string", "null"] },
        "confirmedAt": { "type": ["string", "null"], "description": "ISO 8601 date or date-time from the confirmation record." },
        "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageBoundaries": { "$ref": "#/$defs/readinessCheck" },
            "entryAndReturn": { "$ref": "#/$defs/readinessCheck" },
            "coreStates": { "$ref": "#/$defs/readinessCheck" },
            "mainFlow": { "$ref": "#/$defs/readinessCheck" },
            "exceptionFlow": { "$ref": "#/$defs/readinessCheck" },
            "dataAndContent": { "$ref": "#/$defs/readinessCheck" },
            "scope": { "$ref": "#/$defs/readinessCheck" },
            "designSystem": { "$ref": "#/$defs/readinessCheck" },
            "acceptancePlan": { "$ref": "#/$defs/readinessCheck" }
          },
          "required": ["pageBoundaries", "entryAndReturn", "coreStates", "mainFlow", "exceptionFlow", "dataAndContent", "scope", "designSystem", "acceptancePlan"]
        }
      },
      "required": ["decision", "confirmedBy", "confirmedAt", "sourceRefs", "checks"]
    },
    "assetUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "pageLevel": { "enum": ["landing", "drilldown"] },
        "purpose": { "type": "string", "minLength": 1 }
      },
      "required": ["pageId", "assetId", "purpose"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "prd",
            "screenshot",
            "screen_recording",
            "figma",
            "sens_rule",
            "user_decision"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "location",
        "usage"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "explicit",
            "confirmed",
            "inferred"
          ]
        },
        "category": {
          "enum": [
            "business",
            "data",
            "content",
            "scope",
            "state",
            "flow",
            "validation",
            "design_system"
          ]
        },
        "readinessImpact": {
          "enum": [
            "blocking",
            "non_blocking"
          ]
        },
        "questionRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "description",
        "basis",
        "sourceRefs"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "regions",
        "states"
      ]
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "fromState": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "toState": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "pageId",
        "fromState",
        "trigger",
        "toState",
        "effect",
        "requirementRefs"
      ]
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "type": "string",
          "minLength": 1
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "pageId",
        "field",
        "rule",
        "timing",
        "feedback",
        "requirementRefs"
      ]
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "layout",
            "component"
          ]
        },
        "exportName": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "ruleSourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "candidate",
            "verified"
          ]
        }
      },
      "required": [
        "pageId",
        "region",
        "kind",
        "exportName",
        "variant",
        "ruleSourceRefs",
        "status"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_run"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence",
        "notes"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } }
          },
          "then": {
            "properties": { "evidence": { "minItems": 1 } }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "ready",
              "generated",
              "checked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "designSystem": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "available"
              },
              "assetLocation": {
                "type": "string",
                "minLength": 1
              },
              "mappings": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  }
                }
              }
            }
          },
          "questions": {
            "items": {
              "not": {
                "properties": {
                  "blocking": {
                    "const": true
                  },
                  "status": {
                    "const": "open"
                  }
                },
                "required": [
                  "blocking",
                  "status"
                ]
              }
            }
          },
          "requirements": {
            "minItems": 1
          },
          "actors": {
            "minItems": 1
          },
          "coreTasks": {
            "minItems": 1
          },
          "pages": {
            "minItems": 1
          },
          "flows": {
            "minItems": 1,
            "contains": {
              "properties": {
                "kind": { "const": "main" }
              },
              "required": ["kind"]
            }
          },
          "acceptanceCriteria": {
            "minItems": 1
          },
          "readiness": {
            "properties": {
              "decision": { "const": "confirmed" },
              "confirmedBy": { "type": "string", "minLength": 1 },
              "confirmedAt": { "type": "string", "minLength": 1 },
              "sourceRefs": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "designStatus": {
                "enum": [
                  "approved",
                  "approved_with_followups"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "designerDecision": {
                "type": "string",
                "minLength": 1
              },
              "artifactRevision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "delivery": {
            "properties": {
              "publication": {
                "const": "published"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "delivery": {
            "properties": {
              "previewUrl": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        }
      }
    }
  ]
}
